run = "npx --yes serve -s . -l 5000"
modules = ["nodejs-24"]

# Static deployment: serve the folder as-is (single index.html, no build step).
[deployment]
deploymentTarget = "static"
publicDir = "."

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx --yes serve -s . -l 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
